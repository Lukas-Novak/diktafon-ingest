# Shared Bearer token the phone sends as `Authorization: Bearer <token>`.
# REQUIRED in production — generate a long random string, e.g.:
#   openssl rand -hex 32
DIKTAFON_INGEST_TOKEN=change-me

# Where meetings are stored. Inside docker this is the mounted volume path.
DATA_DIR=/app/data

# Optional outbound webhook: after a memo is successfully stored/updated,
# the service POSTs {"memo_id", "updated"} to this URL (fire-and-forget).
# Leave empty (default) to disable. Notifications are at-least-once —
# consumers should dedupe on memo_id.
DIKTAFON_INGEST_NOTIFY_URL=

# Optional single custom header for the webhook POST (used e.g. for bearer
# auth at the target):
#   DIKTAFON_INGEST_NOTIFY_HEADER="Authorization: Bearer <token>"
DIKTAFON_INGEST_NOTIFY_HEADER=

# Bind address / port. Keep 127.0.0.1 when a TLS-terminating reverse proxy
# (e.g. nginx) fronts the service — the container must not be public directly.
HOST=0.0.0.0
PORT=8378
