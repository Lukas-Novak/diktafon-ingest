# Shared Bearer token the phone sends as `Authorization: Bearer <token>`.
# REQUIRED in production — generate a long random string, e.g.:
#   openssl rand -hex 32
DIKTAFON_INGEST_TOKEN=change-me

# Where meetings are stored. Inside docker this is the mounted volume path.
DATA_DIR=/app/data

# Bind address / port. Keep 127.0.0.1 when a TLS-terminating reverse proxy
# (e.g. nginx) fronts the service — the container must not be public directly.
HOST=0.0.0.0
PORT=8378
